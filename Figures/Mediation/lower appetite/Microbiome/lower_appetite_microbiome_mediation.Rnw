\documentclass[tikz,border=4]{standalone}\usepackage{siunitx}
\usetikzlibrary{positioning}
\tikzset{mynode/.style={draw,text width=2 in,align=center}
}
\begin{document}
  \begin{tikzpicture}
  
  % Mediators
    \node[mynode] (m1){\textbf{LachnospiraceaeUCG001}};
    \node[mynode, below = 0.75 of m1] (m2){\textbf{Papillibacter}};
    
    % Treatments
    \node[mynode, left = 1.5 of m2](a) {\textbf{Vitamin C} \\ Direct Effect: (+) $p = 0.291$ \\ Indirect Effect: (+) $p = 0.065^{.}$ \\ Total Effect: (+) $p = 0.066^{.}$};
    
    % Health Outcomes
    \node[mynode, right = 1.5 of m2](b) {\textbf{Low Appetite} \\ Comparative Fit $= 1.000$ \\ Tucker-Lewis $= 1.674$ \\ RMSEA $< 0.001$ \\ SRMR $=0.016$};
    
    % Vitamin C to mediators
    \draw[-latex] (a.north) -- node[auto,font=\normalsize] {(-)} (m1.west);
    \draw[-latex] (a.east) -- node[auto,font=\normalsize] {(-) .} (m2.west);
    
    
    % Mediators to outcome
    \draw[-latex] (m1.east) -- node[auto,font=\normalsize] {(-)**} (b.north);
    \draw[-latex] (m2.east) -- node[auto,font=\normalsize] {(-)*} (b.west);
    
    

  \end{tikzpicture}
\end{document}