dist_mat <- phyloseq::distance(physeq, method = distance_method)
sample_df <- data.frame(sample_data(physeq))[ , all_vars, drop = FALSE]
sample_df <- sample_df %>% mutate(across(all_of(all_vars), ~if(is.character(.)) as.factor(.) else .))
