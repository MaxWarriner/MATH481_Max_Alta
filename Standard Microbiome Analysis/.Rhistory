min(food[[variable]], na.rm = TRUE),
max(food[[variable]], na.rm = TRUE),
length.out = 100
)
at_list <- list(
calories = mean(food$calories, na.rm = TRUE),
age = mean(food$age, na.rm = TRUE)
)
# add the variable sequence using the string name
at_list[[variable]] <- var_seq
pred <- emmeans(
