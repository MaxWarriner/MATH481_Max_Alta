}
X <- irisC[, 1:4]
labs <- irisC[5]
W <- function(X, labs){
N = nrow(X)
p = ncol(X)
J = length(table(labs))
W = 0
w_cov = array(0, dim = c(p, p))
cov_j = array(0, dim = c(p, p, J))
for(j in 1:J){
nj = nrow(X[labs == j,])
cov_j[, , j] = cov(X[labs == j,])
w_cov = w_cov + (nj-1)*cov_j[, , j]/N
}
for(j in 1:J){
nj = nrow(X[labs == j,])
W = W + nj*det(solve(w_cov)%*%cov_j[, , j] - diag(p))
}
return(W)
}
(statistic <- W(X, labs))
#bootstrapping distribution
